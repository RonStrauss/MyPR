rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function prYear(date) {
      return int(date[0:4]);
    }

    function isValidDate(date) {
      return date is string
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && prYear(date) >= 1900
        && prYear(date) <= 2999;
    }

    function notesValid(data) {
      return !('notes' in data)
        || (
          data.notes is string
          && data.notes.size() > 0
          && data.notes.size() <= 1000
          && !data.notes.matches('.*[<>].*')
        );
    }

    function isValidPr(data) {
      return data.keys().hasAll(['exercise', 'weightKg', 'reps', 'date'])
        && data.exercise is string
        && data.exercise.size() > 0
        && data.exercise.size() <= 120
        && data.weightKg is number
        && data.weightKg >= 0
        && data.reps is int
        && data.reps > 0
        && isValidDate(data.date)
        && notesValid(data);
    }

    match /users/{userId}/prs/{prId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && isValidPr(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && isValidPr(request.resource.data);

      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
